; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Heredita"
config/version="0.1.0"
run/main_scene="uid://bxwiva1eghxgy"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]

Prompts="*res://libraries/Prompts.gd"
QueryParams="*res://libraries/QueryParams.gd"
State="*res://singletons/state/state.gd"
HTTP="*res://libraries/HTTP.gd"
DebugLayer="*res://singletons/debug/DebugLayer.tscn"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=720
window/size/viewport_height=480
window/stretch/aspect="ignore"

[editor]

movie_writer/movie_file="/home/infernity/Godot/MPMap-Redrawn/vidya.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/html5_file_dialog/plugin.cfg", "res://addons/reactive/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "green",
"res://assets/": "blue",
"res://libraries/": "purple",
"res://scenes/": "orange",
"res://singletons/": "pink",
"res://types/": "red"
}

[gui]

theme/custom="uid://csm3q8ve108a8"
theme/custom_font="uid://hwc3xdnlf3ke"

